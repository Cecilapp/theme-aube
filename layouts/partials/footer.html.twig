{%- set aube = site.aube|default({}) -%}
{%- set columns = aube.footer.columns|default([]) -%}
<footer class="site-footer border-top bg-1 mt-12">
  <div class="container py-12">
    <div class="row g-7">
      <div class="lg:col-4">
        <a class="d-inline-flex align-items-center gap-3 mb-5 fw-bold fs-lg fg-body" href="{{ url(site.home) }}">
          {%- set logo = asset(aube.logo|default('images/logo.svg'), {ignore_missing: true}) ~%}
          {%- if aube.logo|default('images/logo.svg') is not empty and not logo.missing ~%}
          <img src="{{ url(logo) }}" alt="" width="32" height="32">
          {%- endif ~%}
          <span>{{ site.title }}</span>
        </a>
        {%- if site.baseline is defined and site.baseline is not empty ~%}
        <p class="fg-secondary mb-3">{{ site.baseline }}</p>
        {%- endif ~%}
        {%- if aube.footer.text|default('') is not empty ~%}
        <div class="small fg-secondary">{{ aube.footer.text|markdown_to_html }}</div>
        {%- endif ~%}
        {%- if aube.social|default([]) is not empty ~%}
        <ul class="list-inline mt-5 mb-0 fs-lg">
          {%- for link in aube.social ~%}
          <li class="list-inline-item"><a href="{{ link.url }}" title="{{ link.name }}" rel="noopener">{{ include('partials/icon.html.twig', {name: link.icon|default(link.name|lower)}, with_context = false) }}<span class="visually-hidden">{{ link.name }}</span></a></li>
          {%- endfor ~%}
        </ul>
        {%- endif ~%}
      </div>
      {%- for column in columns ~%}
      <div class="col-6 lg:col-2{{ loop.first ? ' lg:offset-' ~ (8 - 2 * min(columns|length, 4)) }}">
        <h5 class="fs-md fw-semibold">{{ column.title }}</h5>
        <ul class="list-unstyled small">
          {%- for link in column.links|default([]) ~%}
          <li class="mb-3"><a href="{{ url(link.url) }}">{{ link.name }}</a></li>
          {%- endfor ~%}
        </ul>
      </div>
      {%- endfor ~%}
    </div>
    <hr class="my-7">
    <div class="d-flex flex-column sm:flex-row justify-content-between small fg-secondary gap-3">
      <span>&copy; {{ 'now'|date('Y') }} {{ site.author.name|default(site.title) }}</span>
      {%- if aube.footer.powered_by|default(true) ~%}
      {%- set powered_by -%}
      <a href="https://cecil.app">Cecil</a>
      {%- endset ~%}
      <span>{% trans %}Powered by %powered_by%{% endtrans %}</span>
      {%- endif ~%}
    </div>
  </div>
</footer>
